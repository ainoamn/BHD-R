{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BHD_IDENTITY_ISSUER",
    "BHD_OAUTH_CLIENT_ID",
    "BHD_OAUTH_CLIENT_SECRET",
    "BHD_OAUTH_REDIRECT_URI",
    "BHD_IDENTITY_CLIENT_SECRET",
    "BHD_IDENTITY_REDIRECT_URI",
    "BHD_IDENTITY_TOKEN_SECRET",
    "IDENTITY_TOKEN_SECRET",
    "BHD_R_SESSION_SECRET",
    "CSRF_SECRET",
    "COOKIE_SECURE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "nest-cli.json",
        "next.config.ts",
        "next.config.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
