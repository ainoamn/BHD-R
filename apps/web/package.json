{
  "name": "@bhd-r/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build:packages": "cd ../.. && pnpm exec turbo run build --filter=@bhd-r/config --filter=@bhd-r/contracts --filter=@bhd-r/country-packs --filter=@bhd-r/i18n --filter=@bhd-r/ui --filter=@bhd-r/db --filter=@bhd-r/domain --filter=@bhd-r/authz --filter=@bhd-r/security --force",
    "build": "pnpm run build:packages && next build",
    "start": "next start -p 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "clean": "rimraf .next coverage playwright-report test-results"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@bhd-r/authz": "workspace:*",
    "@bhd-r/config": "workspace:*",
    "@bhd-r/contracts": "workspace:*",
    "@bhd-r/country-packs": "workspace:*",
    "@bhd-r/db": "workspace:*",
    "@bhd-r/domain": "workspace:*",
    "@bhd-r/i18n": "workspace:*",
    "@bhd-r/security": "workspace:*",
    "@bhd-r/ui": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "leaflet": "1.9.4",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "postgres": "^3.4.7",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4.1.18"
  }
}
