{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["lhr1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --config.engine-strict=false",
  "buildCommand": "cd ../.. && pnpm --filter @bhd-r/web run build",
  "crons": [
    {
      "path": "/api/cron/warmup-nest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-locks",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/review-release",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/badges-evaluate",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/tenant-reminders",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/lease-auto-renewals",
      "schedule": "55 3 * * *"
    },
    {
      "path": "/api/cron/send-emails",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/cron/deposit-claim-escalate",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/greeting-campaigns",
      "schedule": "10 * * * *"
    }
  ]
}
