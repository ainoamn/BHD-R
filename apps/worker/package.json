{
  "name": "@bhd-r/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BHD R durable background jobs for media, PDFs, notifications and the transactional outbox",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@bhd-r/security": "workspace:*",
    "bullmq": "^5.65.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "playwright-core": "^1.56.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.6"
  }
}
