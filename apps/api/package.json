{
  "name": "@bhd-r/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@bhd-r/authz": "workspace:*",
    "@bhd-r/config": "workspace:*",
    "@bhd-r/contracts": "workspace:*",
    "@bhd-r/db": "workspace:*",
    "@bhd-r/domain": "workspace:*",
    "@bhd-r/observability": "workspace:*",
    "@bhd-r/security": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/throttler": "^6.4.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.2",
    "jose": "^6.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.9",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
