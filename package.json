{
  "name": "@bhd-r/root",
  "version": "0.8.74",
  "private": true,
  "description": "BHD R — Oman-first bilingual property management platform",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "typescript": "~5.9.3",
      "multer": "^2.5.0",
      "fast-uri": "^3.1.7",
      "source-map-js": "^1.2.2",
      "vite": "^8.2.4",
      "proxy-addr": "^2.0.8",
      "body-parser": "^2.4.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm verify:source && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:source": "node scripts/verify-source.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @bhd-r/db generate",
    "db:migrate": "pnpm --filter @bhd-r/db migrate",
    "db:seed": "pnpm --filter @bhd-r/db seed",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^4.0.15"
  }
}
