FROM node:24-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1
WORKDIR /app
RUN npm install --global pnpm@10.14.0
COPY . .
RUN --mount=type=cache,id=bhd-r-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store \
    && pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG API_INTERNAL_ORIGIN=http://api:4000
ARG MEDIA_PUBLIC_BASE_URL=http://localhost:9000/bhd-r-public
ENV NEXT_PUBLIC_API_ORIGIN=$NEXT_PUBLIC_API_ORIGIN
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV API_INTERNAL_ORIGIN=$API_INTERNAL_ORIGIN
ENV MEDIA_PUBLIC_BASE_URL=$MEDIA_PUBLIC_BASE_URL
RUN pnpm exec turbo run build --filter=@bhd-r/web...

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN npm install --global pnpm@10.14.0 \
    && groupmod --gid 10001 node \
    && usermod --uid 10001 --gid 10001 node
COPY --from=build --chown=node:node /app/apps/web/.next/standalone /app
COPY --from=build --chown=node:node /app/apps/web/.next/static /app/apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public /app/apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
